.PP
To disable the guard for a client that must mutate data, set
\fBreadonly_guard: false\fR in \fBClientConfig\fR, or set the environment
variable \fBJSS_READONLY_GUARD=false\fR.
.SH USAGE EXAMPLES
.SS 1. Session authentication
.nf
use librjss::{RjssClient, ClientConfig, AuthMode};
use secrecy::SecretString;

let config = ClientConfig {
    base_url: "https://app.example.com".parse().unwrap(),
    auth_mode: AuthMode::Session {
        email: SecretString::new("user@example.com".into()),
        password: SecretString::new("secret".into()),
    },
    expected_sitename: None,
    required_roles: vec![],
    timeout_secs: 30,
    max_retries: 3,
    user_agent: "myapp/1.0".into(),
    insecure_ssl: false,
    readonly_guard: true,
};
let mut client = RjssClient::new(config)?;
client.authenticate().await?;
println!("Logged in as: {:?}",
    client.session_info().and_then(|s| s.full_name.as_ref()));
.fi
.SS 2. Basic GET and POST
.nf
let body = client.authenticated_get("/api/resource/ToDo").await?;
let resp = client.authenticated_post(
    "/api/resource/ToDo",
    r#"{"description":"test"}"#
).await?;
.fi
.SS 3. File upload
.nf
let bytes = std::fs::read("photo.png")?;
let result = client.upload_file(
    "photo.png", bytes, "Customer", "CUST-001", "image"
).await?;
.fi
.SS 4. File download
.nf
let bytes = client.download_file("/files/photo.png").await?;
std::fs::write("local.png", bytes)?;
// or directly
client
    .download_file_to_path("/files/photo.png", Path::new("local.png"))
    .await?;
.fi
.SS 5. Download a PDF (Kartu Piutang)
.nf
let pdf_bytes = client.download_pdf_kartu_piutang(
    "Master Data Nasabah",
    "ODR-123",
    "Form Rincian Sisa Piutang Nasabah",
    true  // no_letterhead
).await?;
std::fs::write("piutang.pdf", pdf_bytes)?;
.fi
.SS 6. Running a report
.nf
#[derive(Deserialize)]
struct MyReportRow { /* ... */ }

let rows: Vec<MyReportRow> = client
    .report("Sales Analytics")
    .add_filter("from_date", "2026-01-01")
    .add_filter("to_date", "2026-06-30")
    .run()
    .await?;
.fi
.SS 7. Doctype listing with filters
.nf
let list: serde_json::Value = client
    .doctype("ToDo")
    .filter("status", "=", "Open")
    .fields(vec!["name", "description", "date"])
    .order_by("creation desc")
    .limit(50)
    .execute()
    .await?;

let all: Vec<ToDo> = client
    .doctype("ToDo")
    .filter("status", "=", "Cancelled")
    .all()
    .await?;
.fi
.SS 8. Single document CRUD
.nf
let doc = client.get_doc("Customer", "CUST-001").await?;

#[derive(Serialize)]
struct NewCustomer {
    customer_name: String,
    customer_group: String,
}
let created = client.create_doc("Customer", &new_customer).await?;
let updated = client.update_doc("Customer", "CUST-001", &modification).await?;
let deleted = client.delete_doc("Customer", "OLD-CUST").await?;
.fi
.SS 9. Workflow transition
.nf
let transitions = client
    .workflow_transitions("Surat Diskresi", "SD-0001")
    .await?;
for t in &transitions {
    println!("{} -> {:?}", t.action, t.next_state);
}

// Apply a specific target state
client
    .transition_to_state("Surat Diskresi", "SD-0001", "Approved")
    .await?;
.fi
.SS 10. Calling a server method
.nf
use std::collections::HashMap;

let mut args = HashMap::new();
args.insert("doctype".into(), "Sales Invoice".into());
args.insert("docname".into(), "SINV-0001".into());
let result = client
    .call_method("frappe.client.get_value", Some(args))
    .await?;
.fi
.SS 11. Error handling
.nf
match client.authenticated_get("/api/resource/ToDo").await {
    Err(JssError::ApiError { exc_type, message, status }) => {
        eprintln!("[{exc_type}] {message} (HTTP {status})");
    }
    Err(JssError::RateLimited { retry_after }) => {
        let secs = retry_after.unwrap_or(5);
        tokio::time::sleep(Duration::from_secs(secs)).await;
        // retry
    }
    Err(JssError::Validation(msg)) if msg.contains("READ-ONLY GUARD") => {
        eprintln!("Blocked by read-only guard: {msg}");
    }
    Err(e) => {
        eprintln!("Other error: {}", e);
        let _ = e.status_code();
    }
    Ok(data) => { /* process data */ }
}
.fi
.SS 12. Accessing boot data
.nf
if let Some(boot) = client.boot() {
    println!("Site: {}", boot.sitename);
    println!("Roles: {:?}", boot.user.roles);
    for (doctype, perms) in &boot.user.permissions {
        println!("{} can: {:?}", doctype, perms);
    }
    if client.is_developer_mode() {
        println!("Developer mode active");
    }
    println!("Accessible doctypes: {:?}",
        client.accessible_doctypes());
}
.fi
.SH CONFIGURATION (ENVIRONMENT VARIABLES)
The following variables are consumed by \fBClientConfig::from_env()\fR and
can be adopted in your own applications. They are also used by the bundled
\fBverify_readonly\fR binary.
.TP
\fBJSS_BASE_URL\fR or \fBJSS_URL\fR
Required. Base URL of the JSS instance. Trailing slash is stripped.
.TP
\fBJSS_TOKEN_KEY\fR
API key for token authentication. If set, \fBJSS_TOKEN_SECRET\fR must also
be set. Takes precedence over email/password.
.TP
\fBJSS_TOKEN_SECRET\fR
API secret for token authentication.
.TP
\fBJSS_EMAIL\fR or \fBJSS_USR\fR
Email for session authentication. Required when \fBJSS_TOKEN_KEY\fR is not
set.
.TP
\fBJSS_PASSWORD\fR or \fBJSS_PWD\fR
Password for session authentication.
.TP
\fBJSS_EXPECTED_SITENAME\fR
Optional. Login fails with \fBSitenameMismatch\fR if the boot sitename does
not match.
.TP
\fBJSS_REQUIRED_ROLES\fR
Optional. Comma\-separated required roles; login fails if the user does not
hold at least one.
.TP
\fBJSS_TIMEOUT_SECS\fR
Request timeout in seconds. Default \fB30\fR.
.TP
\fBJSS_MAX_RETRIES\fR
Maximum retry attempts. Default \fB3\fR.
.TP
\fBJSS_USER_AGENT\fR
Custom User\-Agent header. Default \fBlibrjss/2.3.0\fR.
.TP
\fBJSS_INSECURE_SSL\fR
Set to \fBtrue\fR, \fB1\fR, or \fByes\fR to accept invalid TLS certificates
(e.g. self\-signed). Also relaxes the HTTPS\-only check in
\fBClientConfig::validate\fR.
.TP
\fBJSS_READONLY_GUARD\fR
Set to \fBfalse\fR, \fB0\fR, or \fBno\fR to disable the read\-only guard.
Default is enabled.
.SH VERIFY_READONLY BINARY
The crate ships a small binary \fBverify_readonly\fR that snapshots doctype
counts before and after running an operation, then reports any delta.
.PP
Usage:
.nf
\fBverify_readonly snapshot <file.json>\fR
\fBverify_readonly compare <before.json> <after.json>\fR
.fi
.PP
The list of doctypes to check is compiled in. Exit codes:
.RS 4
.IP \[bu] 2
\fB0\fR \- no change detected (server clean).
.IP \[bu]
\fB1\fR \- usage error or I/O error.
.IP \[bu]
\fB2\fR \- change detected on at least one doctype.
.RE
.SH TESTING
Unit tests (no server required):
.PP
\fBcargo test --lib\fR
.PP
Integration tests use \fBwiremock\fR and run without a live server.
The test file \fBtests/fixtures/real_app_page.html\fR is used by
\fBapp_parser\fR to verify parsing of a real \fBfrappe.boot\fR payload.
.PP
Full suite:
.PP
\fBcargo test --workspace --all-targets --all-features\fR
