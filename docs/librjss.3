.SS Memory
.TP
.B void jss_string_free(char *s)
Membebaskan string yang dikembalikan oleh fungsi FFI.
.TP
.B void jss_bytes_free(uint8_t *p, uintptr_t len)
Membebaskan byte buffer yang dikembalikan oleh
.BR jss_client_download_* .
.PP
.B Aturan memori:
.IP \(bu 2
Setiap
.B out_body
yang terisi dengan
.B JSS_OK
wajib di-free dengan
.BR jss_string_free ().
.IP \(bu
Setiap
.B out_data
yang terisi dengan
.B JSS_OK
wajib di-free dengan
.BR jss_bytes_free ().
.IP \(bu
.B jss_last_error()
dan
.B jss_version()
mengembalikan pointer statis/thread-local; jangan di-free.
.IP \(bu
.B JssClient*
dibebaskan dengan
.BR jss_client_free ().
.IP \(bu
Semua
.B out
parameter di-set ke
.B NULL
/
.B 0
terlebih dahulu oleh library jika terjadi error; aman untuk cek nilai
return sebelum membaca.
.SH READ-ONLY GUARD
Secara default,
.B librjss
memasang read-only guard
.RB ( readonly_guard: true ).
Setiap request non-idempotent
.RB ( POST ", " PUT ", " DELETE )
yang path-nya tidak ada di whitelist akan ditolak dengan
.B JssError::Validation
sebelum I/O jaringan terjadi.
.PP
Safe HTTP method
.RB ( GET ", " HEAD ", " OPTIONS )
selalu lolos.
.PP
Whitelist default (subset):
.RS 4
.nf
/api/method/login
/api/method/logout
/api/method/frappe.auth.get_logged_user
/api/method/frappe.sessions.get_csrf_token
/api/method/frappe.client.get_count
/api/method/frappe.client.get_list
/api/method/frappe.client.get_value
/api/method/frappe.client.get
/api/method/frappe.client.validate_link
/api/method/frappe.desk.reportview.get_list
/api/method/frappe.desk.reportview.get_count
/api/method/frappe.desk.search.search_link
/api/method/frappe.desk.form.load.getdoc
/api/method/frappe.desk.form.load.getdoctype
/api/method/frappe.desk.desktop.get_desktop_page
/api/method/frappe.utils.global_search.search
/api/method/frappe.model.workflow.get_transitions
.fi
.RE
.PP
Untuk memperluas, edit
.B ReadOnlyGuard::new()
di
.BR src/client/guard.rs .
Hanya tambahkan endpoint yang sudah kamu audit sebagai read-only.
.PP
Untuk menonaktifkan guard:
.IP \(bu 2
Set
.B readonly_guard: false
di
.BR ClientConfig .
.IP \(bu
Atau set environment variable
.BR JSS_READONLY_GUARD=false .
.PP
Untuk FFI, gunakan flag
.BR JSS_FLAG_NO_READONLY_GUARD .
.SH USAGE EXAMPLES
.SS 1. Session authentication (Rust)
.nf
use librjss::{RjssClient, ClientConfig, AuthMode};
use secrecy::SecretString;

let cfg = ClientConfig {
    base_url: "https://app.example.com".parse()?,
    auth_mode: AuthMode::Session {
        email:    SecretString::new("user@example.com".into()),
        password: SecretString::new("secret".into()),
    },
    expected_sitename: Some("app.example.com".into()),
    required_roles:    vec!["System Manager".into()],
    timeout_secs:      30,
    max_retries:       3,
    user_agent:        "myapp/1.0".into(),
    insecure_ssl:      false,
    readonly_guard:    true,
};

let mut client = RjssClient::new(cfg)?;
client.authenticate().await?;
println!("Logged in as: {:?}",
    client.session_info().and_then(|s| s.full_name.as_ref()));
.fi
.SS 2. Basic GET/POST
.nf
let body = client.authenticated_get("/api/resource/ToDo").await?;

let resp = client
    .authenticated_post(
        "/api/resource/ToDo",
        r#"{"description":"check logs","status":"Open"}"#,
    )
    .await?;
.fi
.SS 3. Doctype listing with filters
.nf
let list: serde_json::Value = client
    .doctype("ToDo")
    .filter("status", "=", "Open")
    .fields(vec!["name", "description", "date"])
    .order_by("creation desc")
    .limit(50)
    .execute()
    .await?;

let all: Vec<ToDo> = client
    .doctype("ToDo")
    .filter("status", "=", "Cancelled")
    .all()
    .await?;
.fi
.SS 4. Single document CRUD
.nf
let doc = client.get_doc("Customer", "CUST-001").await?;

#[derive(serde::Serialize)]
struct NewCustomer { customer_name: String, customer_group: String }

let created = client.create_doc("Customer", &new_customer).await?;
let updated = client.update_doc("Customer", "CUST-001", &patch).await?;
let deleted = client.delete_doc("Customer", "OLD-CUST").await?;
.fi
.SS 5. Report
.nf
#[derive(serde::Deserialize)]
struct Row { name: String, total: f64 }

let rows: Vec<Row> = client
    .report("Sales Analytics")
    .add_filter("from_date", "2026-01-01")
    .add_filter("to_date",   "2026-06-30")
    .run()
    .await?;
.fi
.SS 6. File upload and download
.nf
let bytes = std::fs::read("photo.png")?;
client.upload_file(
    "photo.png", bytes, "Customer", "CUST-001", "image",
).await?;

let bytes = client.download_file("/files/photo.png").await?;
std::fs::write("local.png", bytes)?;

client
    .download_file_to_path("/files/photo.png", Path::new("local.png"))
    .await?;
.fi
.SS 7. PDF print format
.nf
let pdf_bytes = client.download_pdf_kartu_piutang(
    "Master Data Nasabah",
    "ODR-123",
    "Form Rincian Sisa Piutang Nasabah",
    true,   // no_letterhead
).await?;
std::fs::write("piutang.pdf", pdf_bytes)?;
.fi
.SS 8. Workflow transition
.nf
let transitions = client
    .workflow_transitions("Surat Diskresi", "SD-0001")
    .await?;
for t in &transitions {
    println!("{} -> {:?}", t.action, t.next_state);
}

client
    .transition_to_state("Surat Diskresi", "SD-0001", "Approved")
    .await?;
.fi
.SS 9. Error handling
.nf
match client.authenticated_get("/api/resource/ToDo").await {
    Ok(data) => { /* process */ }

    Err(JssError::ApiError { exc_type, message, status }) =>
        eprintln!("[{exc_type}] {message} (HTTP {status})"),

    Err(JssError::RateLimited { retry_after }) => {
        let secs = retry_after.unwrap_or(5);
        tokio::time::sleep(Duration::from_secs(secs)).await;
    }

    Err(JssError::Validation(msg)) if msg.contains("READ-ONLY GUARD") =>
        eprintln!("Blocked by guard: {msg}"),

    Err(e) => eprintln!("Other error: {e} (status {})", e.status_code()),
}
.fi
.SS 10. Boot data
.nf
if let Some(boot) = client.boot() {
    println!("Site:  {}", boot.sitename);
    println!("User:  {} <{}>", boot.user.full_name, boot.user.email);
    println!("Roles: {:?}", boot.user.roles);

    for (doctype, perms) in &boot.user.permissions {
        println!("{doctype} can: {perms:?}");
    }

    if client.is_developer_mode() {
        println!("Developer mode active");
    }
    println!("Accessible: {:?}", client.accessible_doctypes());
}
.fi
.SS 11. C FFI \(em full example
.nf
#include "librjss.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main(void) {
    printf("version: %s\\n", jss_version());

    JssClientConfig cfg;
    memset(&cfg, 0, sizeof(cfg));
    cfg.base_url     = getenv("JSS_BASE_URL");
    cfg.auth_kind    = "session";
    cfg.principal    = getenv("JSS_EMAIL");
    cfg.secret       = getenv("JSS_PASSWORD");
    cfg.flags        = JSS_FLAG_INSECURE_SSL;
    cfg.timeout_secs = 30;
    cfg.max_retries  = 3;

    JssClient *c = jss_client_new(&cfg);
    if (!c) {
        fprintf(stderr, "create: %s\\n", jss_last_error());
        return 1;
    }

    if (jss_client_authenticate(c) != JSS_OK) {
        fprintf(stderr, "auth:   %s\\n", jss_last_error());
        jss_client_free(c);
        return 1;
    }

    char *sitename = NULL;
    if (jss_client_boot_sitename(c, &sitename) == JSS_OK) {
        printf("sitename: %s\\n", sitename);
        jss_string_free(sitename);
    }

    char *body = NULL;
    if (jss_client_get(c, "/api/resource/ToDo?limit_page_length=5",
                       &body) == JSS_OK) {
        puts(body);
        jss_string_free(body);
    }

    jss_client_logout(c);
    jss_client_free(c);
    return 0;
}
.fi
.SS 12. C FFI \(em token auth + flag
.nf
memset(&cfg, 0, sizeof(cfg));
cfg.base_url     = "https://erp.example.com";
cfg.auth_kind    = "token";
cfg.principal    = "abcd1234";          /* api_key    */
cfg.secret       = "efgh5678";          /* api_secret */
cfg.flags        = JSS_FLAG_NO_READONLY_GUARD;
.fi
.SH THREAD SAFETY
.B RjssClient
di Rust adalah
.BR Send " + " Sync ,
sehingga aman untuk dipakai di banyak task Tokio secara bersamaan.
.PP
Di C FFI:
.IP \(bu 2
.B JssClient*
sendiri tidak dilindungi oleh mutex. Kalau kamu mau pakai dari banyak
thread, lindungi dengan mutex sendiri.
.IP \(bu
.B jss_last_error()
adalah thread-local, jadi setiap thread punya slot error sendiri.
.IP \(bu
Setiap panggilan FFI menangkap panic Rust dan mengembalikan
.BR JSS_ERR_PANIC .
.IP \(bu
Runtime Tokio dibangun sekali secara lazy dengan
.BR OnceLock ,
sehingga panggilan FFI dari thread apapun aman.
.SH ENVIRONMENT VARIABLES
Dipakai oleh
.B ClientConfig::from_env()
dan binary
.BR verify_readonly .
.TP
.B JSS_BASE_URL
atau
.B JSS_URL
Required. Base URL instance JSS. Trailing slash di-strip.
.TP
.B JSS_TOKEN_KEY
API key untuk token authentication. Jika di-set,
.B JSS_TOKEN_SECRET
harus ada. Mengalahkan email/password.
.TP
.B JSS_TOKEN_SECRET
API secret untuk token authentication.
.TP
.B JSS_EMAIL
atau
.B JSS_USR
Email untuk session authentication. Required ketika
.B JSS_TOKEN_KEY
tidak di-set.
.TP
.B JSS_PASSWORD
atau
.B JSS_PWD
Password untuk session authentication.
.TP
.B JSS_EXPECTED_SITENAME
Optional. Login gagal dengan
.B SitenameMismatch
jika boot sitename tidak cocok.
.TP
.B JSS_REQUIRED_ROLES
Optional. Comma-separated role yang wajib dimiliki; login gagal jika user
tidak memiliki minimal satu.
.TP
.B JSS_TIMEOUT_SECS
Timeout request dalam detik. Default
.BR 30 .
.TP
.B JSS_MAX_RETRIES
Jumlah retry maksimum. Default
.BR 3 .
.TP
.B JSS_USER_AGENT
Header User-Agent kustom. Default
.BR librjss/2.3.0 .
.TP
.B JSS_INSECURE_SSL
Set ke
.BR true ", " 1 ", atau " yes
untuk menerima certificate TLS invalid. Juga melonggarkan check
HTTPS-only di
.BR ClientConfig::validate .
.TP
.B JSS_READONLY_GUARD
Set ke
.BR false ", " 0 ", atau " no
untuk menonaktifkan read-only guard. Default aktif.
