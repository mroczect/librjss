.SS JssClientConfig
.nf

  typedef struct JssClientConfig {
      const char *base_url;
      const char *auth_kind;        /* "session" | "token"    */
      const char *principal;        /* email     | api_key    */
      const char *secret;           /* password  | api_secret */
      const char *expected_sitename;
      uint32_t    flags;            /* JSS_FLAG_*             */
      uint32_t    _reserved;
      uint64_t    timeout_secs;
      uint32_t    max_retries;
      uint32_t    _reserved2;
  } JssClientConfig;

.fi
Field
.B _reserved
dan
.B _reserved2
harus di-zero. Inisialisasi struct dengan
.B memset(&cfg, 0, sizeof(cfg))
sebelum diisi.
